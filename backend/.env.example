# Saharan Web Factory — backend configuration
# Copy to .env and adjust as needed.

# HTTP server
PORT=8787
HOST=127.0.0.1

# Local Ollama server
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_TIMEOUT_MS=180000
OLLAMA_TEMPERATURE=0.2
OLLAMA_NUM_CTX=8192

# CORS origins allowed to call this API (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# How many extra generation attempts after the first parse/validation failure
PLAN_RETRIES=1

# Build pipeline
MAX_CONCURRENT_BUILDS=1
MAX_REPAIRS=3
# Workspace for generated sites. Keep OUTSIDE the repo tree so OpenCode agents
# stay isolated in their own project directory.
WORKSPACE_DIR=../saharan-web-factory-workspace
PREVIEW_PORT_START=4173
INSTALL_TIMEOUT_MS=600000
BUILD_TIMEOUT_MS=600000
PREVIEW_START_TIMEOUT_MS=45000

# OpenCode CLI
OPENCODE_BIN=/opt/homebrew/bin/opencode
OPENCODE_MODEL=opencode/big-pickle
OPENCODE_TIMEOUT_MS=1800000